<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AirPods などの接続と名前 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 内蔵タイマーの終了通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 通知を出したアプリのアイコンと名前を引く。どのアプリが来るか事前に分からず、
         サイドロード専用（Play の審査対象外）なので全件で構わない -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 電池残量低下の表示から省電力をオンにする。adb の pm grant で一度許可してもらう（無ければ設定画面を開く） -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- 音楽の波形を実際の音に合わせる（Visualizer で端末の出力音声を解析する。録音はしない） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".IslandApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Island"
        android:supportsRtl="false">

        <activity
            android:name=".ui.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- QS タイルを長押ししたときの行き先 -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".builtin.TimerPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Island.Dialog" />

        <activity
            android:name=".builtin.TimerRingingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleInstance" />

        <service
            android:name=".overlay.IslandOverlayService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/island_accessibility" />
        </service>

        <service
            android:name=".source.IslandNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".builtin.StopwatchTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_stopwatch"
            android:label="@string/tile_stopwatch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <service
            android:name=".builtin.TimerTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_timer"
            android:label="@string/tile_timer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <receiver
            android:name=".builtin.TimerAlarmReceiver"
            android:exported="false" />

        <!-- Shizuku が動き出したとき・このアプリが起動したときに、Shizuku の binder を受け取る口。
             INTERACT_ACROSS_USERS_FULL はシステム（と Shizuku）しか持たない -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 実機確認スクリプト用。DUMP 権限は adb shell とシステムしか持たない -->
        <activity
            android:name=".debug.LightBackgroundActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name=".debug.FullscreenTestActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".debug.ShellCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
